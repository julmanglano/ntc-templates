Value Required MEMBER (\S+)
Value IP_CONFIG (\S+)
Value IP_ADDRESS (\d{1,3}(?:\.\d{1,3}){3})
Value PREFIX_LENGTH (\d+)
Value ADDR_STATUS (\S+)
Value INTF_STATUS (\S+)

Start
  ^\s*IPv4\s+Status\s*:.*$$
  ^\s*IPv4\s+Default\s+Gateway\s*:.*$$
  ^\s*\|\s+Address\s+Interface\s*$$ -> Interfaces
  ^\s*$$
  ^. -> Error

Interfaces
  ^\s*Member\s+\|\s+IP\s+Config\s+IP\s+Address/Prefix\s+Length\s+Status\s+Status\s*$$
  ^\s*-+\s+\+\s+-+\s+-+\s+-+\s+-+\s*$$
  ^\s*${MEMBER}\s+\|\s+${IP_CONFIG}\s+${IP_ADDRESS}/${PREFIX_LENGTH}\s+${ADDR_STATUS}\s+${INTF_STATUS}\s*$$ -> Record
  ^\s*${MEMBER}\s+\|\s+${IP_CONFIG}\s+${INTF_STATUS}\s*$$ -> Record
  ^\s*$$
  ^. -> Error
